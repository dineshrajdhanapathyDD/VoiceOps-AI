# Template for Streamlit secrets. Placeholders only - never commit real values.
#
# Streamlit Community Cloud: paste the filled-in contents into
#   your app > Settings > Secrets
# Local testing: copy to .streamlit/secrets.toml (already gitignored).
#
# Only needed for the optional Amazon Bedrock explanation. The core analyzer
# works without any secrets.

[aws]
aws_access_key_id = "<access-key-id>"
aws_secret_access_key = "<secret-access-key>"
# aws_session_token = "<only for temporary credentials>"
region = "us-east-1"

[voiceops]
# Recommended for public apps: visitors must enter this before Bedrock runs.
# Remove the line to disable the check.
bedrock_access_code = "<choose-a-long-random-code>"
